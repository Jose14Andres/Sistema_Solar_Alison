  },
  {
   "id": "guia47",
   "who": "guia",
   "text": "Ahora es de día.",
   "file": "audio/guia47.mp3"
  },
  {
   "id": "guia48",
   "who": "guia",
   "text": "Ahora es de noche.",
   "file": "audio/guia48.mp3"
  },
  {
   "id": "guia49",
   "who": "guia",
   "text": "Con media vuelta, Quito pasó al otro lado: el lado que no mira al Sol.",
   "file": "audio/guia49.mp3"
  },
  {
   "id": "guia50",
   "who": "guia",
   "text": "Con media vuelta, Quito pasó al otro lado: el lado que mira al Sol.",
